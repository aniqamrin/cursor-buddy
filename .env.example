# Copy this file to .env and fill in your key, or add the key
# inside Cursor Buddy → Settings → AI (stored locally in SQLite).
# The key is consumed by the Rust core only — it never enters the web bundle.

OPENAI_API_KEY=sk-your-key-here

# Optional: point the provider at a compatible gateway/local server.
# OPENAI_BASE_URL=https://api.openai.com/v1
